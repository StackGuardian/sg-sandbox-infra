{
  "type": "object",
  "properties": {
    "location": {
      "title": "Azure region",
      "type": "string",
      "default": "westeurope"
    },
    "name_prefix": {
      "title": "Name prefix",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,15}$",
      "default": "sgsandbox"
    },
    "container_name": {
      "title": "Container name",
      "type": "string",
      "pattern": "^[a-z0-9](-?[a-z0-9])+$",
      "maxLength": 63,
      "default": "data"
    }
  }
}
