{
  "type": "object",
  "properties": {
    "region": {
      "title": "AWS Region",
      "type": "string",
      "enum": [
        "us-east-1",
        "us-east-2",
        "us-west-1",
        "us-west-2",
        "af-south-1",
        "ap-east-1",
        "ap-south-1",
        "ap-south-2",
        "ap-southeast-1",
        "ap-southeast-2",
        "ap-southeast-3",
        "ap-southeast-4",
        "ap-southeast-5",
        "ap-northeast-1",
        "ap-northeast-2",
        "ap-northeast-3",
        "ca-central-1",
        "ca-west-1",
        "eu-central-1",
        "eu-central-2",
        "eu-west-1",
        "eu-west-2",
        "eu-west-3",
        "eu-south-1",
        "eu-south-2",
        "eu-north-1",
        "il-central-1",
        "me-south-1",
        "me-central-1",
        "sa-east-1"
      ],
      "default": "eu-central-1"
    },
    "name": {
      "title": "Name prefix",
      "type": "string",
      "pattern": "^(?!sg-)[a-z][a-z0-9-]{1,30}$",
      "default": "sandbox-k3s"
    },
    "use_default_vpc": {
      "title": "Use the default VPC",
      "type": "boolean",
      "default": false
    },
    "vpc_cidr": {
      "title": "VPC CIDR",
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|1[0-9]|2[0-4])$",
      "default": "10.61.0.0/16"
    },
    "instance_type": {
      "title": "Instance type",
      "type": "string",
      "default": "t3.small"
    },
    "root_volume_size_gb": {
      "title": "Root volume size (GiB)",
      "type": "number",
      "minimum": 10,
      "maximum": 100,
      "default": 20
    },
    "allowed_cidr": {
      "title": "SSH and Kubernetes API allowed from",
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$",
      "default": "0.0.0.0/0"
    }
  }
}
