{
  "type": "object",
  "properties": {
    "region": {
      "title": "AWS Region",
      "type": "string",
      "enum": [
        "us-east-1",
        "us-east-2",
        "us-west-2",
        "eu-central-1",
        "eu-west-1",
        "eu-west-2",
        "ap-south-1",
        "ap-southeast-1",
        "ap-northeast-1"
      ],
      "enumNames": [
        "US East (N. Virginia)",
        "US East (Ohio)",
        "US West (Oregon)",
        "Europe (Frankfurt)",
        "Europe (Ireland)",
        "Europe (London)",
        "Asia Pacific (Mumbai)",
        "Asia Pacific (Singapore)",
        "Asia Pacific (Tokyo)"
      ],
      "default": "eu-central-1"
    },
    "name": {
      "title": "Name prefix",
      "type": "string",
      "pattern": "^(?!sg-)[a-z][a-z0-9-]{1,30}$",
      "default": "sandbox-k3s"
    },
    "use_default_vpc": {
      "title": "Use the default VPC",
      "type": "boolean",
      "default": false
    },
    "vpc_cidr": {
      "title": "VPC CIDR",
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|1[0-9]|2[0-4])$",
      "default": "10.61.0.0/16"
    },
    "instance_type": {
      "title": "Instance type",
      "type": "string",
      "enum": [
        "t3.small",
        "t3.medium"
      ],
      "enumNames": [
        "t3.small: 2 vCPU, 2 GiB",
        "t3.medium: 2 vCPU, 4 GiB"
      ],
      "default": "t3.small"
    },
    "root_volume_size_gb": {
      "title": "Root volume size",
      "type": "number",
      "enum": [
        20,
        40
      ],
      "enumNames": [
        "20 GiB",
        "40 GiB"
      ],
      "default": 20
    },
    "allowed_cidr": {
      "title": "Kubernetes API allowed from",
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$",
      "default": "0.0.0.0/0"
    },
    "kubeconfig_wait_seconds": {
      "title": "Wait for the kubeconfig",
      "type": "number",
      "enum": [
        180,
        300,
        600
      ],
      "enumNames": [
        "3 minutes",
        "5 minutes",
        "10 minutes"
      ],
      "default": 300
    }
  }
}
