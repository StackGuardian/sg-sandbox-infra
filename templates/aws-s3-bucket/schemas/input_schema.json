{
  "type": "object",
  "properties": {
    "region": {
      "title": "AWS Region",
      "type": "string",
      "enum": [
        "us-east-1",
        "us-east-2",
        "us-west-2",
        "eu-central-1",
        "eu-west-1",
        "eu-west-2",
        "ap-south-1",
        "ap-southeast-1",
        "ap-northeast-1"
      ],
      "enumNames": [
        "US East (N. Virginia)",
        "US East (Ohio)",
        "US West (Oregon)",
        "Europe (Frankfurt)",
        "Europe (Ireland)",
        "Europe (London)",
        "Asia Pacific (Mumbai)",
        "Asia Pacific (Singapore)",
        "Asia Pacific (Tokyo)"
      ],
      "default": "eu-central-1"
    },
    "bucket_prefix": {
      "title": "Bucket name prefix",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,45}$",
      "default": "sg-sandbox"
    },
    "versioning_enabled": {
      "title": "Versioning",
      "type": "boolean",
      "default": true
    },
    "noncurrent_version_expiration_days": {
      "title": "Delete old versions after",
      "type": "number",
      "enum": [
        7,
        30,
        90,
        365
      ],
      "enumNames": [
        "7 days",
        "30 days",
        "90 days",
        "365 days"
      ],
      "default": 30
    }
  }
}
