{
  "type": "object",
  "properties": {
    "project_id": {
      "title": "Project ID",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "minLength": 6
    },
    "region": {
      "title": "Google Cloud region",
      "type": "string",
      "default": "us-central1"
    },
    "zone": {
      "title": "Zone",
      "type": "string",
      "default": "us-central1-a"
    },
    "name_prefix": {
      "title": "Name prefix",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
      "default": "sgsandbox"
    },
    "machine_type": {
      "title": "Machine type",
      "type": "string",
      "default": "e2-micro"
    },
    "external_ip_enabled": {
      "title": "External IP",
      "type": "boolean",
      "default": true
    },
    "allowed_ssh_cidrs": {
      "title": "SSH allowed from",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
      },
      "default": []
    }
  },
  "required": [
    "project_id"
  ]
}
