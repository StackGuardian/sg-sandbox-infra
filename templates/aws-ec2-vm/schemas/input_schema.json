{
  "type": "object",
  "properties": {
    "region": {
      "title": "AWS Region",
      "type": "string",
      "enum": [
        "us-east-1",
        "us-east-2",
        "us-west-2",
        "eu-central-1",
        "eu-west-1",
        "eu-west-2",
        "ap-south-1",
        "ap-southeast-1",
        "ap-northeast-1"
      ],
      "enumNames": [
        "US East (N. Virginia)",
        "US East (Ohio)",
        "US West (Oregon)",
        "Europe (Frankfurt)",
        "Europe (Ireland)",
        "Europe (London)",
        "Asia Pacific (Mumbai)",
        "Asia Pacific (Singapore)",
        "Asia Pacific (Tokyo)"
      ],
      "default": "eu-central-1"
    },
    "name": {
      "title": "Name prefix",
      "type": "string",
      "pattern": "^(?!sg-)[a-z][a-z0-9-]{1,30}$",
      "default": "sandbox-vm"
    },
    "use_default_vpc": {
      "title": "Use the default VPC",
      "type": "boolean",
      "default": false
    },
    "vpc_cidr": {
      "title": "VPC CIDR",
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|1[0-9]|2[0-4])$",
      "default": "10.60.0.0/16"
    },
    "instance_type": {
      "title": "Instance type",
      "type": "string",
      "enum": [
        "t3.nano",
        "t3.micro",
        "t3.small",
        "t4g.nano",
        "t4g.micro",
        "t4g.small"
      ],
      "enumNames": [
        "t3.nano: 2 vCPU, 0.5 GiB",
        "t3.micro: 2 vCPU, 1 GiB",
        "t3.small: 2 vCPU, 2 GiB",
        "t4g.nano: 2 vCPU, 0.5 GiB, Graviton (arm64)",
        "t4g.micro: 2 vCPU, 1 GiB, Graviton (arm64)",
        "t4g.small: 2 vCPU, 2 GiB, Graviton (arm64)"
      ],
      "default": "t3.micro"
    },
    "root_volume_size_gb": {
      "title": "Root volume size",
      "type": "number",
      "enum": [
        8,
        16,
        32
      ],
      "enumNames": [
        "8 GiB",
        "16 GiB",
        "32 GiB"
      ],
      "default": 8
    },
    "allowed_ingress_cidrs": {
      "title": "SSH allowed from",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
      },
      "default": []
    }
  }
}
