{
  "type": "object",
  "properties": {
    "location": {
      "title": "Azure region",
      "type": "string",
      "enum": [
        "eastus",
        "eastus2",
        "westus2",
        "westus3",
        "centralus",
        "canadacentral",
        "northeurope",
        "westeurope",
        "germanywestcentral",
        "francecentral",
        "uksouth",
        "swedencentral",
        "switzerlandnorth",
        "australiaeast",
        "japaneast",
        "southeastasia"
      ],
      "default": "westeurope"
    },
    "cluster_name": {
      "title": "Cluster name",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
      "default": "demo-aks"
    },
    "resource_group_name": {
      "title": "Resource group",
      "type": "string",
      "minLength": 1,
      "default": "rg-demo-aks"
    },
    "kubernetes_version": {
      "title": "Kubernetes version",
      "type": "string",
      "enum": [
        "1.29",
        "1.30",
        "1.31"
      ],
      "default": "1.31"
    },
    "node_vm_size": {
      "title": "Node VM size",
      "type": "string",
      "default": "Standard_D2s_v5"
    },
    "node_count": {
      "title": "Node count",
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "default": 2
    },
    "api_server_public_access": {
      "title": "Public API server",
      "type": "boolean",
      "default": false
    },
    "tags": {
      "title": "Tags",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {
        "environment": "sandbox",
        "managed_by": "stackguardian"
      }
    }
  }
}
