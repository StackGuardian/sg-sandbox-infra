{
  "type": "object",
  "properties": {
    "location": {
      "title": "Azure region",
      "type": "string",
      "enum": [
        "eastus",
        "westus2",
        "westeurope",
        "northeurope",
        "germanywestcentral",
        "southeastasia",
        "japaneast"
      ],
      "enumNames": [
        "US: East US",
        "US: West US 2",
        "Europe: West Europe (Netherlands)",
        "Europe: North Europe (Ireland)",
        "Europe: Germany West Central",
        "Asia: Southeast Asia (Singapore)",
        "Asia: Japan East"
      ],
      "default": "westeurope"
    },
    "name_prefix": {
      "title": "Name prefix",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$",
      "default": "sgsandbox"
    },
    "vm_size": {
      "title": "VM size",
      "type": "string",
      "enum": [
        "Standard_B1s",
        "Standard_B1ms",
        "Standard_B2s"
      ],
      "enumNames": [
        "B1s: 1 vCPU, 1 GiB",
        "B1ms: 1 vCPU, 2 GiB",
        "B2s: 2 vCPU, 4 GiB"
      ],
      "default": "Standard_B1s"
    },
    "os_disk_size_gb": {
      "title": "OS disk size",
      "type": "number",
      "enum": [
        30,
        64,
        128
      ],
      "enumNames": [
        "30 GiB",
        "64 GiB",
        "128 GiB"
      ],
      "default": 30
    },
    "public_ip_enabled": {
      "title": "Public IP",
      "type": "boolean",
      "default": true
    },
    "allowed_ssh_cidrs": {
      "title": "SSH allowed from",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
      },
      "default": []
    },
    "auto_shutdown_enabled": {
      "title": "Daily auto-shutdown",
      "type": "boolean",
      "default": true
    },
    "auto_shutdown_time": {
      "title": "Shutdown time (UTC)",
      "type": "string",
      "enum": [
        "1700",
        "1900",
        "2100",
        "2300"
      ],
      "enumNames": [
        "17:00",
        "19:00",
        "21:00",
        "23:00"
      ],
      "default": "1900"
    }
  }
}
