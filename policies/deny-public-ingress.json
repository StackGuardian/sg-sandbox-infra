{
  "meta": {
    "version": "v1",
    "required_provider": "stackguardian/terraform_plan"
  },
  "evaluators": [
    {
      "id": "no_public_ingress",
      "description": "Resources must not accept traffic from the internet",
      "provider_args": {
        "operation_type": "attribute",
        "terraform_resource_type": "*",
        "terraform_resource_attribute": "input.public_ingress"
      },
      "condition": {
        "type": "Equals",
        "value": false,
        "error_tolerance": 2
      }
    }
  ],
  "eval_expression": "no_public_ingress"
}
